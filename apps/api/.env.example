APP_MODE=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/megha_laundry?replicaSet=megha
FRONTEND_ORIGIN=http://127.0.0.1:3000
PAYMENT_PROVIDER=development
ENABLE_CHECKOUT=true
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=.local/uploads
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CRON_SECRET=
# Shipping: development (local), demo (hosted demo; requires Razorpay test keys), shiprocket, or disabled.
SHIPPING_PROVIDER=development
# Shiprocket API user (Settings > API in Shiprocket), pickup location name and its PIN code.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_PINCODE=
# Token entered in Shiprocket webhook settings; sent back as the x-api-key header.
SHIPROCKET_WEBHOOK_TOKEN=
# Used for delivery rates when a product has no shipping weight.
DEFAULT_ITEM_WEIGHT_KG=1
# Email: development (writes to EMAIL_OUTBOX_DIR), smtp, or disabled.
EMAIL_PROVIDER=development
EMAIL_FROM=Megha Laundry Equipment <no-reply@example.com>
EMAIL_OUTBOX_DIR=.local/outbox
# SMTP account from your email service (Gmail, Zoho, Brevo, Amazon SES, ...). Port 465 uses TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# New enquiry, service and Find My Spare alerts go here; leave empty to skip them.
STAFF_ALERT_EMAIL=
# Public storefront address, used in email links (no trailing slash).
SITE_URL=http://127.0.0.1:3000
# City/state lookup for PIN codes at checkout: india-post (public service, cached) or disabled.
PINCODE_LOOKUP=india-post
