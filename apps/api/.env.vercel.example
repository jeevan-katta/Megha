# API Vercel project only. Replace every YOUR_* value before deployment.
APP_MODE=production
MONGODB_URI=mongodb+srv://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@YOUR_CLUSTER/megha_client_demo?retryWrites=true&w=majority
FRONTEND_ORIGIN=https://YOUR-FRONTEND.vercel.app
SITE_URL=https://YOUR-FRONTEND.vercel.app
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=YOUR_RAZORPAY_TEST_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_TEST_KEY_SECRET
ENABLE_CHECKOUT=true
SHIPPING_PROVIDER=demo
DEFAULT_ITEM_WEIGHT_KG=1
EMAIL_PROVIDER=disabled
STORAGE_PROVIDER=disabled
PINCODE_LOOKUP=disabled
